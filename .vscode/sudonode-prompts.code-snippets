{
  "Sudonode module prompt": {
    "prefix": "sudoModulePrompt",
    "body": [
      "project: ${1:Module name}",
      "",
      "intent:",
      "  ${2:Describe what this module should do in one or two sentences.}",
      "",
      "constraints:",
      "  - language: JavaScript ES modules",
      "  - style: functional & pure",
      "  - no frameworks",
      "  - no database",
      "  - no side effects unless explicitly stated",
      "  - use JSDoc where helpful",
      "",
      "environment:",
      "  - Node.js 24+",
      "  - optional browser compatibility",
      "",
      "types:",
      "  type ${3:TypeName}:",
      "    ${4:fieldName}: ${5:type}",
      "",
      "functions:",
      "  function ${6:functionName}(${7:args}) -> ${8:ReturnType}",
      "    steps:",
      "      - ${9:step 1}",
      "      - ${10:step 2}",
      "",
      "output:",
      "  - Target file: ${11:src/moduleName.js}",
      "  - ES module syntax (export functions)",
      "  - No external dependencies",
      "  - JSDoc typedef for public types and functions",
      ""
    ],
    "description": "Template for a sudolang-ish module prompt (.prompt.md)"
  },

  "Sudonode tests prompt": {
    "prefix": "sudoTestPrompt",
    "body": [
      "project: ${1:Module tests}",
      "",
      "intent:",
      "  Write tests for the ${2:module name} module using node:test.",
      "",
      "constraints:",
      "  - language: JavaScript ES modules",
      "  - test framework: node:test + assert",
      "  - small, focused test cases",
      "",
      "environment:",
      "  - Node.js 24+",
      "  - module under test: ${3:src/moduleName.js}",
      "",
      "tests:",
      "  describe \"${4:group name}\":",
      "    - should ${5:do something}",
      "    - should ${6:handle error case}",
      "",
      "output:",
      "  - Target file: ${7:test/moduleName.test.js}",
      "  - Import `test` from 'node:test' and `strict as assert` from 'node:assert'",
      "  - Import functions from '../src/moduleName.js'",
      ""
    ],
    "description": "Template for a test-spec prompt file"
  },

  "Sudonode base AIDD prompt header": {
    "prefix": "sudoBasePromptHeader",
    "body": [
      "# AI-Driven Development – Base Prompt",
      "",
      "You are an AI software engineer.",
      "",
      "Follow these rules:",
      "",
      "- Interpret pseudocode as intent, not literal syntax.",
      "- Generate clean, idiomatic JavaScript for Node.js with ES modules.",
      "- Use JSDoc for type information where it improves readability.",
      "- Prefer pure functions and functional style (no mutation of inputs).",
      "- Keep code framework-agnostic: no web frameworks, no DB drivers.",
      "- No external dependencies unless explicitly requested.",
      "- For tests, use node:test and assert.",
      "",
      "You will be given:",
      "- A module or test prompt in this sudonode DSL",
      "",
      "Task:",
      "- Implement or refactor the target file so it matches the intent and pseudocode.",
      "- Keep functions small and composable.",
      "- Favor clarity over cleverness.",
      ""
    ],
    "description": "Reusable AIDD base prompt header to paste into prompt files"
  },

  "RITEWay node:test case": {
    "prefix": "riteTest",
    "body": [
      "test('${1:group}: given ${2:state}, when ${3:action}, should ${4:result}', () => {",
      "  // arrange",
      "  ${5:const prev = createCounter(${6:0});}",
      "  // act",
      "  ${7:const next = increment(prev, ${8:1});}",
      "  // assert",
      "  ${9:assert.strictEqual(getValue(next), ${10:1});}",
      "});"
    ],
    "description": "RITEWay-style single-assertion node:test block"
  }
}
